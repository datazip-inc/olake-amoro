{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verify Java 17",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "set -euo pipefail; JDK17_HOME=\"\"; if [ -n \"${JAVA_HOME:-}\" ]; then VER=$(\"$JAVA_HOME/bin/java\" -version 2>&1 | awk -F '\"|\\.' '/version/ {print $2; exit}'); if [ \"$VER\" = \"17\" ]; then JDK17_HOME=\"$JAVA_HOME\"; fi; fi; if [ -z \"$JDK17_HOME\" ]; then if command -v /usr/libexec/java_home >/dev/null 2>&1; then JDK17_HOME=$(/usr/libexec/java_home -v 17 2>/dev/null || true); fi; fi; if [ -z \"$JDK17_HOME\" ]; then echo 'JDK 17 is required but not found. Install JDK 17 and set JAVA_HOME to it.'; exit 1; fi; VER=$(\"$JDK17_HOME/bin/java\" -version 2>&1 | awk -F '\"|\\.' '/version/ {print $2; exit}'); if [ \"$VER\" != \"17\" ]; then echo \"JDK 17 is required, but found Java $VER at $JDK17_HOME\"; exit 1; fi; echo \"Using JDK 17: $JDK17_HOME\""
      ],
      "problemMatcher": []
    }
  ]
}
